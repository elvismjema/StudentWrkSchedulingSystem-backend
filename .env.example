# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workerscheduling
DB_USER=root
DB_PASSWORD=***

# Auth
JWT_SECRET=change...ring
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=***

# CORS
CORS_ORIGIN=https://workerscheduling.eaglesoftwareteam.com

# App
PORT=3000
NODE_ENV=production
TZ=America/Chicago

# Notifications: in-app + optional Email/SMS channels
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_SMS_ENABLED=false

# SMTP (email)
# Option A: full connection URL
SMTP_URL=
# Option B: host/port/user/pass
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@workerscheduling.local

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Current user model has no phone column; use fallback target for testing:
NOTIFICATION_SMS_FALLBACK_TO=

# Web Push (browser + PWA notifications)
#
# Generate a keypair ONCE and use the same pair in every environment that
# shares the database, otherwise subscriptions stored against old keys are
# silently rejected by the push provider:
#   npx web-push generate-vapid-keys
#
# VAPID_EMAIL must be a mailto: URL the push provider can contact if your
# server is sending abusive traffic — it's what Mozilla/Google enforce,
# not something users ever see.
#
# If any of the three are missing, the backend still boots but every push
# send silently short-circuits with skippedReason:"vapid-not-configured".
# That's the exact failure mode students hit when they claim push isn't
# working — in-app notifications succeed, web push doesn't.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@workerscheduling.eaglesoftwareteam.com

# ---------------------------------------------------------------------------
# OneSignal (primary push provider)
# ---------------------------------------------------------------------------
# OneSignal owns service worker registration, iOS PWA quirks, and subscription
# lifecycle. When both are set, notificationService routes pushes through
# OneSignal and only falls back to VAPID/web-push if OneSignal is not
# configured. Users are matched by external_id = String(userId), which the
# frontend sets via OneSignal.login() after a successful auth.
#
# Get these from the OneSignal dashboard:
#   App ID        → Settings → Keys & IDs → OneSignal App ID
#   REST API Key  → Settings → Keys & IDs → Rest API Key (server-side only,
#                   never expose in the client bundle)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
