{
  "type": "module",
  "name": "tutorial-backend",
  "version": "1.0.0",
  "description": "Tutorial Node.js with Rest API",
  "main": "server.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "start": "node server.js",
    "schema:sync": "node scripts/ensureProductionSchema.mjs",
    "bundle": "rm -rf deploy && mkdir deploy && cp -r app migrations scripts server.js package.json package-lock.json workerscheduling-t2-backend.service .env deploy"
  },
  "keywords": [
    "node.js",
    "express",
    "sequelize"
  ],
  "author": "cs",
  "license": "ISC",
  "engines": {
    "node": ">=18 <23"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "express-winston": "^4.2.0",
    "googleapis": "^100.0.0",
    "jest": "^29.3.1",
    "jsonwebtoken": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.0",
    "mysql2": "^2.3.3",
    "sequelize": "^6.19.0",
    "supertest": "^6.3.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0"
  }
